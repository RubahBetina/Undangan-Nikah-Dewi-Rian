# GEMINI_API_KEY: Optional for AI studio environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional — leave empty to use the built-in Express backend;
# set both values to connect your live Supabase project for Auth, Postgres, and Storage)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SESSION_SECRET: Secret key used for signing local Express admin session cookies
SESSION_SECRET="atelier-fleur-change-this-in-production"
